# Copia este archivo como .env y rellena los valores. .env nunca se sube a git.

# Acceso al panel /admin. En producción la contraseña debe tener al menos 12 caracteres.
NUXT_ADMIN_USER=
NUXT_ADMIN_PASSWORD=

# Clave para cifrar la cookie de sesión del panel: 32 caracteres aleatorios o más.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Solo en local: permite entrar al panel con una contraseña corta. NUNCA en producción.
# NUXT_ALLOW_WEAK_PASSWORD=true

# PostgreSQL. En local es opcional: sin ella, npm run dev usa PGlite (Postgres embebido en .data/pglite).
# NUXT_DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/rentahucha
